  "derivations": {
    "charging.statistical_scope": {"inputs": ["charging.chargers_total_10k"], "formula": "year < 2025: EVCIPA_2020_2024; otherwise NEA_connectors_2025_revised; documented in series_breaks.charging", "alignment": "same year; categorical scope metadata, not a numeric estimate"},
    "sales.nev_share_of_new_sales_pct": {"inputs": ["sales.nev_sales_10k", "sales.auto_sales_10k"], "formula": "round(100 * nev_sales_10k / auto_sales_10k, 2)", "alignment": "same year"},
    "fleet.bev_share_pct": {"inputs": ["fleet.bev_fleet_10k", "fleet.nev_fleet_10k"], "formula": "round(100 * bev_fleet_10k / nev_fleet_10k, 2)", "alignment": "same year"},
    "charging.nev_fleet_10k": {"inputs": ["fleet.nev_fleet_10k"], "formula": "one-to-one left join from charging to fleet on year", "alignment": "same year; no positional slicing"},
    "charging.chargers_private_10k": {"inputs": ["charging.chargers_total_10k", "charging.chargers_public_10k"], "formula": "chargers_total_10k - chargers_public_10k", "alignment": "same year"},
    "charging.public_share_pct": {"inputs": ["charging.chargers_public_10k", "charging.chargers_total_10k"], "formula": "round(100 * chargers_public_10k / chargers_total_10k, 2)", "alignment": "same year"},
    "charging.vehicles_per_charger": {"inputs": ["fleet.nev_fleet_10k", "charging.chargers_total_10k"], "formula": "round(nev_fleet_10k / chargers_total_10k, 2)", "alignment": "same year"},
    "battery.total_gwh": {"inputs": ["battery.lfp_gwh", "battery.nmc_gwh"], "formula": "lfp_gwh + nmc_gwh; two-chemistry subtotal only", "alignment": "same year"},
    "battery.lfp_share_pct": {"inputs": ["battery.lfp_gwh", "battery.nmc_gwh"], "formula": "round(100 * lfp_gwh / (lfp_gwh + nmc_gwh), 2)", "alignment": "same year"},
    "powertrain.total_10k": {"inputs": ["powertrain.bev_sales_10k", "powertrain.phev_sales_10k"], "formula": "bev_sales_10k + phev_sales_10k; two-powertrain subtotal only", "alignment": "same year"},
    "powertrain.bev_share_pct": {"inputs": ["powertrain.bev_sales_10k", "powertrain.phev_sales_10k"], "formula": "round(100 * bev_sales_10k / (bev_sales_10k + phev_sales_10k), 2)", "alignment": "same year"},
    "powertrain.phev_share_pct": {"inputs": ["powertrain.bev_sales_10k", "powertrain.phev_sales_10k"], "formula": "round(100 * phev_sales_10k / (bev_sales_10k + phev_sales_10k), 2)", "alignment": "same year"},
    "exports.ice_exports_10k": {"inputs": ["exports.total_exports_10k", "exports.nev_exports_10k"], "formula": "total_exports_10k - nev_exports_10k; residual category only", "alignment": "same year"},
    "exports.nev_share_of_exports_pct": {"inputs": ["exports.nev_exports_10k", "exports.total_exports_10k"], "formula": "round(100 * nev_exports_10k / total_exports_10k, 2)", "alignment": "same year"},
    "carbon.nev_fleet_10k": {"inputs": ["fleet.nev_fleet_10k"], "formula": "copy fleet by year", "alignment": "same year"},
    "carbon.annual_co2_avoided_100mt": {"inputs": ["fleet.nev_fleet_10k", "assumptions.carbon_factor"], "formula": "nev_fleet_10k * carbon_factor / 10000", "alignment": "same year fleet; constant assumed factor"},
    "carbon.cumulative_co2_avoided_100mt": {"inputs": ["fleet.nev_fleet_10k", "assumptions.carbon_factor"], "formula": "cumulative sum of annual scenario values in ascending year order, then round to 6 decimals", "alignment": "all fleet years through observation year"}
  },
